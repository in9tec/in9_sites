# Variáveis para o ambiente de produção (ex.: Vercel).
# IMPORTANTE: NEXT_PUBLIC_DEV_MODE deve ficar false/ausente em produção.
# O código já trava o bypass de auth quando NODE_ENV=production, mas mantenha
# false aqui como cinto de segurança extra.
NEXT_PUBLIC_DEV_MODE=false

# Domínio público do site, sem barra no final. Usado por robots.ts, sitemap.ts
# e redirects de auth. Ex.: https://in9.studio
NEXT_PUBLIC_SITE_URL=https://in9.studio
